{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "piano": {
      "type": "string",
      "enum": [
        "free",
        "annuale",
        "permanente"
      ],
      "default": "free",
      "description": "Piano attivo (free/annuale/permanente)"
    },
    "anno_gratuito": {
      "type": "string",
      "description": "Anno scolastico gratuito assegnato alla prima attivazione"
    },
    "anni_licenza": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Anni scolastici sbloccati tramite acquisto"
    },
    "ads_removed": {
      "type": "boolean",
      "default": false,
      "description": "Rimozione banner pubblicitari acquistata"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "Account disabilitato dall'amministratore"
    },
    "user_id": {
      "type": "string",
      "description": "ID dell'utente a cui appartiene l'entitlement (chiave di lookup server-side)"
    }
  },
  "required": [
    "piano"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}